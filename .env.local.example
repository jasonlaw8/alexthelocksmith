# Copy to .env.local and fill in.

# PostHog analytics + session replay. Both are NEXT_PUBLIC_ (the project token
# is designed to be public and ships in the client bundle). Omit the key to
# disable PostHog entirely in an environment.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Not read by anything yet - for Supabase-backed features when they're added.
NEXT_PUBLIC_SITE_URL=https://alexthelocksmith.net
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
